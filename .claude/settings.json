{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(xargs ls:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
