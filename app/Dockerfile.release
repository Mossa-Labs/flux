# syntax=docker/dockerfile:1
#
# Community release image — ghcr.io/mossa-labs/flux/community
# Production build of the public Apache-2.0 Flux (Community Edition). No Pro/EE
# code: in-memory queue, Basic AI, HTTP/Postgres sinks; S3/RabbitMQ resolve to
# upgrade-prompt stubs.
#
# Build (context = app/):
#   docker build -f app/Dockerfile.release -t ghcr.io/mossa-labs/flux/community:latest app/
#
# Multi-arch (amd64 + arm64/Graviton/Apple Silicon) needs buildx, and MUST use a
# native runner per architecture. QEMU emulation does not work: the BEAM fails to
# boot under it ("failed_to_start_child,user,nouser" at the first `mix` call),
# which reproduces with the stock hexpm/elixir image and is not specific to this
# Dockerfile. Build each arch on its own runner and merge the manifests:
#
#   # on an amd64 runner, and again on an arm64 runner
#   docker buildx build -f app/Dockerfile.release \
#     -t ghcr.io/mossa-labs/flux/community:<version>-$(uname -m) --push app/
#   docker buildx imagetools create -t ghcr.io/mossa-labs/flux/community:<version> \
#     ghcr.io/mossa-labs/flux/community:<version>-x86_64 \
#     ghcr.io/mossa-labs/flux/community:<version>-aarch64
#
# Run migrations as a one-shot before starting the app:
#   bin/flux eval "Flux.Release.migrate()"
#
# The plain `app/Dockerfile` remains the local-dev container (runs phx.server).

ARG ELIXIR_VERSION=1.19.4
ARG OTP_VERSION=28.2
ARG UBUNTU_VERSION=noble-20251013
ARG BUILDER_IMAGE="hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-ubuntu-${UBUNTU_VERSION}"
ARG RUNNER_IMAGE="ubuntu:${UBUNTU_VERSION}"

# ---- build ----
FROM ${BUILDER_IMAGE} AS builder

RUN apt-get update -y && apt-get install -y build-essential git nodejs npm \
  && apt-get clean && rm -f /var/lib/apt/lists/*_*

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=prod

COPY mix.exs mix.lock ./
RUN mix deps.get --only prod
RUN mkdir config
COPY config/config.exs config/prod.exs config/
RUN mix deps.compile

COPY priv priv
COPY lib lib
COPY assets assets
# Release node-distribution config (rel/env.sh.eex pins RELEASE_NODE). Mix picks
# `rel/` up as rel_templates_path during `mix release`, so it must be present in
# the build context — otherwise the release silently ships without it and the
# node name falls back to the default.
COPY rel rel
# JS deps (uplot, React Flow) — assets/node_modules is gitignored, so install
# in-image rather than relying on the host's copy.
RUN npm --prefix assets ci
# Compile first: Phoenix 1.8 colocated hooks are emitted under
# _build/$MIX_ENV/phoenix-colocated during compile, and esbuild imports them.
RUN mix compile
RUN mix assets.deploy

COPY config/runtime.exs config/
RUN mix release

# ---- runtime ----
FROM ${RUNNER_IMAGE}

RUN apt-get update -y \
  && apt-get install -y libstdc++6 openssl libncurses6 locales ca-certificates \
  && apt-get clean && rm -f /var/lib/apt/lists/*_*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

WORKDIR /app
RUN chown nobody /app
ENV MIX_ENV=prod
# config/runtime.exs only starts the endpoint when PHX_SERVER is set, and this
# release has no generated `bin/server` script — without this the container boots
# the app with nothing listening on $PORT.
ENV PHX_SERVER=true

COPY --from=builder --chown=nobody:root /app/_build/prod/rel/flux ./

USER nobody

# Default release boot. Run migrations first as a one-shot:
#   bin/flux eval "Flux.Release.migrate()"
CMD ["/app/bin/flux", "start"]
