# syntax=docker/dockerfile:1
#
# Community release image — ghcr.io/mossa-labs/flux/community
# Production build of the public Apache-2.0 Flux (Community Edition). No Pro/EE
# code: in-memory queue, Basic AI, HTTP/Postgres sinks; S3/RabbitMQ resolve to
# upgrade-prompt stubs.
#
# Build (context = app/):
#   docker build -f app/Dockerfile.release -t ghcr.io/mossa-labs/flux/community:latest app/
#
# Multi-arch (amd64 + arm64/Graviton/Apple Silicon) needs buildx, and MUST use a
# native runner per architecture. QEMU emulation does not work: the BEAM fails to
# boot under it ("failed_to_start_child,user,nouser" at the first `mix` call),
# which reproduces with the stock hexpm/elixir image and is not specific to this
# Dockerfile. Build each arch on its own runner and merge the manifests:
#
#   # on an amd64 runner, and again on an arm64 runner
#   docker buildx build -f app/Dockerfile.release \
#     -t ghcr.io/mossa-labs/flux/community:<version>-$(uname -m) --push app/
#   docker buildx imagetools create -t ghcr.io/mossa-labs/flux/community:<version> \
#     ghcr.io/mossa-labs/flux/community:<version>-x86_64 \
#     ghcr.io/mossa-labs/flux/community:<version>-aarch64
#
# Run migrations as a one-shot before starting the app:
#   bin/flux eval "Flux.Release.migrate()"
#
# The plain `app/Dockerfile` remains the local-dev container (runs phx.server).

ARG ELIXIR_VERSION=1.19.4
ARG OTP_VERSION=28.2
ARG UBUNTU_VERSION=noble-20251013
ARG BUILDER_IMAGE="hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-ubuntu-${UBUNTU_VERSION}"
ARG RUNNER_IMAGE="ubuntu:${UBUNTU_VERSION}"

# ---- build ----
FROM ${BUILDER_IMAGE} AS builder

RUN apt-get update -y && apt-get install -y build-essential git nodejs npm \
  && apt-get clean && rm -f /var/lib/apt/lists/*_*

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=prod

# Build identity (MOS-586). Injected, because git is unavailable at runtime and
# `.git` is excluded from the build context. Promoted to ENV so config/config.exs
# can read them at COMPILE time — Flux.BuildInfo resolves them via compile_env.
# Left unset (a local build) they resolve to "dev" and the build reports itself
# as unreleased.
#
# FLUX_VERSION belongs in THIS stage, not just the runtime one (MOS-596). It is
# read by mix.exs, so it sets the app version, the OTP release directory name and
# RELEASE_VSN together. Previously it was declared only at runtime, where it
# reached /etc/flux-release and the OCI labels but never the compiler — so an
# image tagged 0.2.1 shipped an app, and a /app/releases directory, saying 0.2.0.
# They had agreed at 0.2.0 purely because mix.exs happened to hold the same
# number.
ARG FLUX_CORE_SHA
ARG FLUX_BUILD_TIME
ARG FLUX_VERSION
ENV FLUX_CORE_SHA=${FLUX_CORE_SHA} FLUX_BUILD_TIME=${FLUX_BUILD_TIME} FLUX_VERSION=${FLUX_VERSION}

COPY mix.exs mix.lock ./
RUN mix deps.get --only prod
RUN mkdir config
COPY config/config.exs config/prod.exs config/
RUN mix deps.compile

COPY priv priv
COPY lib lib
COPY assets assets
# Release node-distribution config (rel/env.sh.eex pins RELEASE_NODE). Mix picks
# `rel/` up as rel_templates_path during `mix release`, so it must be present in
# the build context — otherwise the release silently ships without it and the
# node name falls back to the default.
COPY rel rel
# JS deps (uplot, React Flow) — assets/node_modules is gitignored, so install
# in-image rather than relying on the host's copy.
RUN npm --prefix assets ci
# Compile first: Phoenix 1.8 colocated hooks are emitted under
# _build/$MIX_ENV/phoenix-colocated during compile, and esbuild imports them.
RUN mix compile
RUN mix assets.deploy

COPY config/runtime.exs config/
RUN mix release

# Hand the RESOLVED version to the runtime stage. Taken from the release itself
# rather than from the build arg, so it is correct whether or not FLUX_VERSION was
# passed: with no arg, mix.exs falls back to its literal and this picks that up.
# start_erl.data is "<erts_vsn> <release_vsn>".
RUN awk '{print $2}' _build/prod/rel/flux/releases/start_erl.data > /app/FLUX_VERSION

# ---- runtime ----
FROM ${RUNNER_IMAGE}

RUN apt-get update -y \
  && apt-get install -y libstdc++6 openssl libncurses6 locales ca-certificates \
  `# curl: a container healthcheck and any k8s/ECS probe need an HTTP client.` \
  `# ubuntu:noble ships none, so a healthcheck against /health fails forever` \
  `# and the container reports unhealthy while serving traffic perfectly well.` \
  curl \
  && apt-get clean && rm -f /var/lib/apt/lists/*_*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

WORKDIR /app
RUN chown nobody /app
ENV MIX_ENV=prod
# config/runtime.exs only starts the endpoint when PHX_SERVER is set, and this
# release has no generated `bin/server` script — without this the container boots
# the app with nothing listening on $PORT.
ENV PHX_SERVER=true

ARG FLUX_CORE_SHA
ARG FLUX_BUILD_TIME
# No default. `=0.1.0` was the worst available value: plausible enough to be
# believed and false in every build that ever existed. The version this stage
# records comes from the builder, which read it off the release itself.
ARG FLUX_VERSION

COPY --from=builder /app/FLUX_VERSION /tmp/flux-version

# os-release-style identity file. Readable with `docker exec cat /etc/flux-release`
# even when the app will not boot — which is exactly when the build identity is
# most needed and the running app can no longer report it.
RUN printf '%s\n' \
  "FLUX_EDITION=Community" \
  "FLUX_VERSION=$(cat /tmp/flux-version)" \
  "FLUX_CORE_SHA=${FLUX_CORE_SHA:-dev}" \
  "FLUX_BUILD_TIME=${FLUX_BUILD_TIME:-unknown}" \
  > /etc/flux-release \
  && rm /tmp/flux-version

# Standard OCI annotations: `docker inspect` answers "what is this image?" WITHOUT
# running the container, which is the only option when triaging a crash-looping
# deploy or auditing what a customer actually pulled.
# LABEL cannot read a file, so the version label is the one place the build arg
# is still consulted directly. A build that made no version claim is labelled
# "dev" rather than a number it did not earn — /etc/flux-release still carries
# the true compiled version either way.
LABEL org.opencontainers.image.title="Flux Community" \
      org.opencontainers.image.description="Self-hosted ETL/ELT platform (Community Edition)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${FLUX_VERSION:-dev}" \
      org.opencontainers.image.revision="${FLUX_CORE_SHA}" \
      org.opencontainers.image.created="${FLUX_BUILD_TIME}"

COPY --from=builder --chown=nobody:root /app/_build/prod/rel/flux ./

USER nobody

# Default release boot. Run migrations first as a one-shot:
#   bin/flux eval "Flux.Release.migrate()"
CMD ["/app/bin/flux", "start"]
