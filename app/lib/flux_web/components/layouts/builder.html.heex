<div class="h-screen w-screen flex flex-col bg-base-200 font-sans antialiased text-base-content">
  <%!-- Header matching dashboard navbar --%>
  <div class="navbar bg-base-100/80 backdrop-blur-md border-b border-base-200 flex-shrink-0 relative z-[100]">
    <div class="flex-none pl-4">
      <.link navigate={~p"/pipelines"}>
        <Brand.brand_mark />
      </.link>
    </div>
    <div class="flex-1 px-4">
      <h1 class="text-xl font-bold tracking-tight text-base-content">
        {assigns[:page_title] || "Pipeline Builder"}
      </h1>
    </div>
    <div class="flex-none gap-2">
      <span :if={assigns[:save_status]} class="text-sm text-base-content/60 mr-2">
        {assigns[:save_status]}
      </span>
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-ghost btn-circle avatar placeholder">
          <div class="bg-neutral text-neutral-content rounded-full w-10">
            <span class="text-xs">UI</span>
          </div>
        </label>
        <ul
          tabindex="0"
          class="mt-3 z-[1] p-2 shadow menu menu-sm dropdown-content bg-base-200 rounded-box w-52 border border-hairline text-sm font-medium"
        >
          <li><.link href={~p"/users/settings"}>Settings</.link></li>
          <li><.link href={~p"/users/log-out"} method="delete">Logout</.link></li>
        </ul>
      </div>
    </div>
  </div>

  <%!-- Canvas container --%>
  <main class="flex-1 relative overflow-hidden">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
