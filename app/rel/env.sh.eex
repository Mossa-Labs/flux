#!/bin/sh
# Erlang release environment.
#
# Pins a stable node name so `bin/flux remote` / `rpc` / `stop` reach the RUNNING
# release rather than a guess. Cluster formation itself is a paid capability
# configured elsewhere; this file only settles identity, which every build needs.
#
# POSIX sh only — this is sourced by the generated bin/<release> script, which
# runs under /bin/sh. No [[ ]], no `local`, no arrays, no +=.

# ── Node identity ────────────────────────────────────────────────────────────
#
# The generated script sources this file on EVERY invocation — start, eval, rpc,
# remote, stop, pid — each in its own shell. Nothing caches the name and nothing
# asks the running VM for it. So a name derived from the environment is only
# correct if every invocation sees the same environment, and under `docker exec`
# it does not: exec builds its environment from the image ENV plus the container's
# create-time env, and inherits nothing PID 1 exported at runtime.
#
# That is a real failure, not a hypothetical one. A deployment that sets POD_IP
# inside its entrypoint (rather than in the container's declared environment)
# boots as `name@<container-ip>`, while a later `docker exec ... rpc` recomputes
# `name@127.0.0.1` and fails with `:noconnection` — which reads as "the node is
# down" when the node is serving traffic perfectly well.
#
# Two layers, because each covers the other's gap:
#
#   1. derive — so an exec that happens BEFORE start has written anything still
#      computes something sane;
#   2. persist — `start` records the name it actually booted with, and other
#      subcommands read it back. Strictly more correct than recomputing: if the
#      container's address changes after boot (a network reconnect, a re-lease),
#      the BEAM keeps its boot-time name and a fresh derivation would be wrong.
#
# This is only possible because the generated script exports RELEASE_COMMAND
# before sourcing this file, so the branch below can see which subcommand ran.

# RELEASE_TMP is defaulted by the generated script AFTER this file is sourced, so
# default it the same way here. `start` already requires this directory to be
# writable — it stages the runtime sys.config into it — so recording a node name
# there adds no new requirement. Any environment where this write fails is one
# where `start` was already going to fail.
_flux_node_file="${RELEASE_TMP:-$RELEASE_ROOT/tmp}/$RELEASE_NAME-$RELEASE_VSN.node"

# `hostname -I` reads the configured addresses directly. `hostname -i` resolves
# the hostname instead, and on a host whose name is not in /etc/hosts it prints a
# warning to stderr and NOTHING to stdout — which falls through to 127.0.0.1 and
# leaves a node that boots, serves traffic, and silently never joins a cluster.
# Prefer -I; keep -i as a fallback for systems whose hostname(1) lacks -I.
_flux_ip() {
  _out="$(hostname -I 2>/dev/null)"
  [ -n "$_out" ] || _out="$(hostname -i 2>/dev/null)"

  # Either flag may return several space-separated addresses. Prefer the first
  # IPv4; fall back to the first token so an IPv6-only host still gets a name.
  _v4="$(printf '%s' "$_out" | tr ' ' '\n' \
         | grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' | head -n 1)"
  if [ -n "$_v4" ]; then
    printf '%s' "$_v4"
  else
    printf '%s' "$_out" | awk '{print $1}'
  fi
}

case "$RELEASE_COMMAND" in
  start | start_iex | daemon | daemon_iex)
    if [ -z "$RELEASE_NODE" ]; then
      _ip="${POD_IP:-$(_flux_ip)}"

      if [ -z "$_ip" ]; then
        # Refusing to boot is the kinder failure when this node is MEANT to
        # cluster: a node named 127.0.0.1 starts, passes its healthcheck, serves
        # traffic, and never joins — and an unclustered peer duplicates work
        # rather than sharing it. Fail loudly with the two ways out.
        if [ -n "$DNS_CLUSTER_QUERY" ]; then
          echo "ERROR: could not determine this node's IP address, but" >&2
          echo "DNS_CLUSTER_QUERY is set, so this node is expected to join a" >&2
          echo "cluster. Booting as 127.0.0.1 would start a node that serves" >&2
          echo "traffic and never clusters. Set POD_IP or RELEASE_NODE." >&2
          exit 1
        fi

        _ip="127.0.0.1"
      fi

      RELEASE_NODE="<%= @release.name %>@${_ip}"
    fi
    export RELEASE_NODE

    # Record what we actually booted as. Best-effort: a read-only filesystem must
    # not stop a release from starting, and the derivation above still applies.
    { mkdir -p "$(dirname "$_flux_node_file")" \
        && printf '%s\n' "$RELEASE_NODE" > "$_flux_node_file"; } 2>/dev/null || true
    ;;

  *)
    # Prefer what the running node recorded over recomputing.
    if [ -z "$RELEASE_NODE" ] && [ -r "$_flux_node_file" ]; then
      RELEASE_NODE="$(cat "$_flux_node_file" 2>/dev/null)"
    fi

    if [ -z "$RELEASE_NODE" ]; then
      _ip="${POD_IP:-$(_flux_ip)}"
      RELEASE_NODE="<%= @release.name %>@${_ip:-127.0.0.1}"
    fi
    export RELEASE_NODE
    ;;
esac

# ── Distribution ─────────────────────────────────────────────────────────────

# The node name is host-qualified (an IP contains dots), which requires LONG
# names. Mix releases default to RELEASE_DISTRIBUTION=sname, and a short name must
# not contain dots — booting that way dies at net_kernel with `nodistribution`.
# Guarded so an operator can still choose `none` (no epmd) or `sname`.
if [ -z "$RELEASE_DISTRIBUTION" ]; then
  export RELEASE_DISTRIBUTION="name"
fi

# APPEND rather than assign: ERL_AFLAGS is an operator knob (TLS distribution,
# scheduler binding, inet6). Overwriting it silently discards their configuration.
export ERL_AFLAGS="-proto_dist inet_tcp${ERL_AFLAGS:+ $ERL_AFLAGS}"

unset _flux_node_file _out _v4 _ip
