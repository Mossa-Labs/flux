#!/bin/sh
# Erlang release environment for the Community (single-node) edition.
#
# A single-node deployment needs no cluster formation; this file just pins a
# stable node name so `bin/flux remote` / `rpc` work against a running release.
# Horizontal scaling / HA (DNS-based cluster formation) is a Flux Pro feature and
# is configured by the Pro release, not here.

# Node name: prefer an explicit RELEASE_NODE; otherwise derive it from the
# host IP, falling back to 127.0.0.1 for the typical single-node deployment.
if [ -z "$RELEASE_NODE" ]; then
  export RELEASE_NODE="<%= @release.name %>@${POD_IP:-127.0.0.1}"
fi

# The node name above is host-qualified (an IP contains dots), which requires
# LONG names. Mix releases default to RELEASE_DISTRIBUTION=sname, and a short
# name must not contain dots — booting that way dies at net_kernel with
# `nodistribution`. Set it explicitly unless the operator overrode it.
if [ -z "$RELEASE_DISTRIBUTION" ]; then
  export RELEASE_DISTRIBUTION="name"
fi
