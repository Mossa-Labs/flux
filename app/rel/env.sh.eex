#!/bin/sh
# Distributed Erlang configuration for HA clustering (MOS-459 / MOS-529).
#
# Releases default to short names ("sname"), which only connect to peers on the
# same host. For a multi-node cluster behind a load balancer we need long names
# ("name") so DNSCluster can connect nodes across hosts.
#
# All nodes must share the same Erlang cookie. They do automatically when they
# run the same release image (the cookie is baked into the build); otherwise set
# RELEASE_COOKIE to an identical value on every node.

export ERL_AFLAGS="-proto_dist inet_tcp"
export RELEASE_DISTRIBUTION="name"

# Node name: prefer an explicit RELEASE_NODE; otherwise derive it from the pod /
# host IP (e.g. Kubernetes injects POD_IP via fieldRef). Falls back to
# 127.0.0.1 for a single-node deployment. The basename ("<%= @release.name %>")
# must match what DNS_CLUSTER_QUERY resolves to, so every node uses it.
if [ -z "$RELEASE_NODE" ]; then
  export RELEASE_NODE="<%= @release.name %>@${POD_IP:-127.0.0.1}"
fi
